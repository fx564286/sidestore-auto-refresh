{
  "schema": 1,
  "product": "Scarlet Crystal",
  "baseline": "Scarlet Crystal legacy UI patches V144–V170, as authored by the user",
  "release_policy": "fail_closed_no_design_regressions",
  "requirements": [
    {
      "key": "glass_panel",
      "path": "MultitaskSupport/MultitaskDockView.swift",
      "all": [
        "SCARLET_V144_GLASS_INSTALLED",
        "SCARLET_V149_TABS"
      ],
      "purpose": "Custom native Liquid Glass panel and segmented tabs"
    },
    {
      "key": "equal_panel_sizes",
      "path": "MultitaskSupport/MultitaskDockView.swift",
      "all": [
        "SCARLET_V158_EQUAL_TAB_FRAME",
        "SCARLET_V159_PINNED_OUTER_FRAME"
      ],
      "purpose": "Keep equal recent/window-manager panel geometry"
    },
    {
      "key": "native_longpress",
      "path": "MultitaskSupport/MultitaskDockView.swift",
      "all": [
        "SCARLET_V158_ACTION_UNCLIPPED",
        "SCARLET_V159_ACTION_NATIVE_PRESS"
      ],
      "purpose": "Prevent clipped long-press action buttons; no fabricated custom scale"
    },
    {
      "key": "outside_tap",
      "path": "MultitaskSupport/MultitaskDockView.swift",
      "all": [
        "SCARLET_V160_OUTSIDE_RETURN",
        "SCARLET_V144_WINDOW_OUTSIDE_TAP"
      ],
      "purpose": "Dismiss glass panel on outside touch"
    },
    {
      "key": "finger_and_contrast",
      "path": "MultitaskSupport/MultitaskDockView.swift",
      "all": [
        "SCARLET_V160_GLASS_CONTRAST",
        "SCARLET_V160_GUEST_WINDOW_COORDS"
      ],
      "purpose": "Preserve gesture response and visible optical contrast"
    },
    {
      "key": "single_guest_route",
      "path": "MultitaskSupport/MultitaskDockView.swift",
      "all": [
        "SCARLET_V155_DOCK_SINGLE_MODE"
      ],
      "purpose": "One LiveProcess app-control route, no duplicate Direct UI"
    },
    {
      "key": "single_route_shell",
      "path": "LiveContainerSwiftUI/Views/V3UnifiedShell.swift",
      "all": [
        "SCARLET_V155_NO_DIRECT_PRESENTER"
      ],
      "purpose": "Preserve the customized unified shell"
    },
    {
      "key": "rotation",
      "path": "MultitaskSupport/DecoratedAppSceneViewController.m",
      "all": [
        "SCARLET_V169_EVENT_DRIVEN_VIEWPORT",
        "SCARLET_V170_LANDSCAPE_ONLY"
      ],
      "purpose": "Preserve event-driven orientation and bounded landscape adjustment"
    }
  ],
  "nonnegotiable": [
    "Do not replace custom UI with stock LiveContainer UI",
    "Never treat a successful build without the UI contract as a complete Scarlet Crystal IPA",
    "Do not change installed app identity, profiles, pairing or user data to satisfy this check",
    "No app-store or signing changes as a substitute for UI validation"
  ],
  "device_verification_required": true
}

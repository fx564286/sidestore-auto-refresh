/* Scarlet Crystal iPhone GitHub request v2.
   Native Shortcuts, no SSH, NAS port or hardcoded GitHub PAT.
   Errors are presented before the result page is opened.
*/
#define name "Scarlet Crystal 서명 요청 점검"
#define color purple
#define glyph smileyFace
#include 'actions/web'
#question githubToken "GitHub Fine-grained PAT (이 저장소 Actions: Read and write)" ""
@token = text(githubToken)
if !@token {
  alert("GitHub 토큰이 비어 있습니다. 저장소 주소가 아닌 Fine-grained PAT를 입력해야 합니다.", "서명 요청 중단")
  stop()
}
if @token == "fx564286/sidestore-auto-refresh" {
  alert("입력된 내용은 GitHub 저장소 이름입니다. 실제 GitHub PAT가 아닙니다.", "서명 요청 중단")
  stop()
}
@sent = jsonRequest(
  "https://api.github.com/repos/fx564286/sidestore-auto-refresh/actions/workflows/scarlet-sign-request.yml/dispatches",
  "POST",
  {"ref": "main"},
  {"Authorization": "Bearer {@token}", "Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28"}
)
/* GitHub POST 204 has an empty response body. A returned JSON body is
   typically an HTTP API error: never treat it as signing success. */
if @sent {
  alert("GitHub에서 응답 내용을 반환했습니다. 다음 화면에서 요청 오류가 있는지 확인하세요. 비밀 토큰은 출력하지 않습니다.", "GitHub 응답 확인")
  quicklook(@sent)
  stop()
}
wait(4)
openURL("https://fx564286.github.io/sidestore-auto-refresh/scarlet-sign.html")

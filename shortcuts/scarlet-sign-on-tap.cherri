/* iPhone tap -> GitHub owner workflow_dispatch -> CachyOS local signer.
   iOS cellular/WiFi. No SSH, NAS host, schedule or WebClip.
   On import, user supplies a GitHub fine-grained PAT limited to
   fx564286/sidestore-auto-refresh with Actions: Read and write.
   No token or Apple certificate is included in published source/binary.
*/
#define name "Scarlet Crystal 눌러서 서명"
#define color purple
#define glyph smileyFace
#include 'actions/web'
#question githubToken "GitHub 토큰 (이 저장소 Actions: Read and write 권한)" ""
@token = text(githubToken)
@authorization = "Bearer {@token}"
@sent = jsonRequest(
  "https://api.github.com/repos/fx564286/sidestore-auto-refresh/actions/workflows/scarlet-sign-request.yml/dispatches",
  "POST",
  {"ref": "main"},
  {"Authorization": @authorization, "Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28"}
)
openURL("https://fx564286.github.io/sidestore-auto-refresh/scarlet-sign.html")

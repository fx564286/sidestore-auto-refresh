#define name "Scarlet Crystal NAS 자동 배포"
#define color purple
#define glyph smileyFace
#include 'actions/network'
#include 'actions/web'
#question nasHost "NAS SSH 주소" ""
#question nasPort "NAS SSH 포트" "22"
#question nasUser "NAS 사용자" "aggressivo"
#question nasPassword "NAS 암호" ""
@empty = nothing()
@script = "set -eu\nPC=hanabi@192.168.50.59\nKEY=\"\"\nfor CANDIDATE in \"$HOME/.ssh/scarlet_pc_ed25519\" \"$HOME/.ssh/id_ed25519\" \"/shared/lan-control/credentials/arch-pc/id_ed25519\"; do\n  if [ -r \"$CANDIDATE\" ] && ssh -T -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=yes -i \"$CANDIDATE\" \"$PC\" true >/dev/null 2>&1; then\n    KEY=\"$CANDIDATE\"\n    break\n  fi\ndone\nif [ -z \"$KEY\" ]; then\n  printf '%s\\n' '[STOP] NAS_TO_PC_SSH_KEY_MISSING' >&2\n  exit 51\nfi\nssh -T -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=yes -i \"$KEY\" \"$PC\" 'bash -s' <<'SCARLET_PC'\nset -eu\nD=\"$HOME/.local/share/scarlet-crystal/latest-publisher\"\nmkdir -p \"$D\"\nURL=\"https://raw.githubusercontent.com/fx564286/sidestore-auto-refresh/feat/scarlet-universal-shortcut-publisher-20261105/tools/scarlet_latest_publish.py\"\ncurl -fLSs --retry 3 --connect-timeout 15 --max-time 60 \"$URL\" -o \"$D/latest.py.tmp\"\npython3 -m py_compile \"$D/latest.py.tmp\"\nmv -f \"$D/latest.py.tmp\" \"$D/latest.py\"\npython3 \"$D/latest.py\" 2>> \"$D/last-run.log\"\nSCARLET_PC"
@result = runSSHScript(@script, @empty, nasHost, nasPort, nasUser, "Password", nasPassword)
openURL("\(@result)")

     /// A real protective backup into `<Documents>/<udid>/`.
+    /// Explicit experimental iOS 27 restore without a device backup.
+    /// The device may reject this manifest or become unbootable.
+    private func unprotectedIOS27Restore(udid: String) throws -> URL {
+        let backupRoot = AppPaths.fullBackupRoot(udid: udid)
+        try resetDirectory(backupRoot)
+        let deviceDir = AppPaths.deviceDir(backupRoot: backupRoot, udid: udid)
+        try HostManifests.ensure(deviceDir: deviceDir, udid: udid,
+                                 ios27: true, isFullBackup: false)
+        try HostManifests.writeUnprotectedRestoreSQLite(deviceDir: deviceDir)
+        log("UNSAFE: iOS 27 protective backup SKIPPED by user opt-in; no device state "
+            + "was saved; restore may be rejected or leave the device unbootable.")
+        return backupRoot
+    }

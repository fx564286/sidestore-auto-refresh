+/// Display-only Korean copy for the current verified community catalog.
+/// The server's metadata, hashes, package bytes and file paths remain intact.
+private enum CommunityCopyKorean {
+    static func name(id: String, fallback: String) -> String {
+        let known: [String: String] = [
+            "calm-glass": "차분한 글래스",
+            "clean-home-screen": "깔끔한 홈 화면",
+            "cool-nugget": "쿨 너겟",
+            "developer-toolkit": "개발자 도구 모음",
+            "fewer-distractions": "방해 요소 줄이기",
+            "liquid-glass-everywhere": "전체 리퀴드 글래스",
+            "preset-1": "프리셋 1",
+            "secret-bootloop-button": "비밀 부팅 루프 버튼(위험)",
+            "solid-glass": "단색 글래스",
+            "springboard-for-ios-27-1-duo": "iOS 27.1용 SpringBoard 설정(Duo)"
+        ]
+        return known[id] ?? fallback
+    }
+
+    static func detail(templateID id: String, fallback: String) -> String {
+        let known: [String: String] = [
+            "calm-glass": "리퀴드 글래스는 유지하면서 잠금 화면, 위젯, Dock 및 폴더의 움직이는 광택 효과를 제거합니다.",
+            "clean-home-screen": "Dock 위 검색 버튼, 아이콘 시차 효과, 시계 아이콘 초침 움직임, Dock 및 검색창 그림자를 없애 홈 화면을 단정하게 만듭니다.",
+            "cool-nugget": "쿨 너겟 프리셋",
+            "developer-toolkit": "상태 막대 빌드 번호, 터치 시각화, App Store 디버그 제스처, 메모 앱 디버그 메뉴와 액세서리 개발자 설정을 활성화합니다.",
+            "fewer-distractions": "잠금 화면 충전 상태, 상태 막대의 앱으로 돌아가기 버튼, Spotlight 웹사이트 검색 결과를 숨깁니다.",
+            "liquid-glass-everywhere": "리퀴드 글래스 효과를 활성화합니다.",
+            "preset-1": "공유된 프리셋 1",
+            "secret-bootloop-button": "성능 향상을 주장하는 고위험 프리셋입니다. 부팅 문제가 발생할 수 있으므로 파일 변경 내용을 확인하세요.",
+            "solid-glass": "Dock과 잠금 화면 시계의 리퀴드 글래스 외관을 끕니다.",
+            "springboard-for-ios-27-1-duo": "iOS 27.1(24A94401) 시뮬레이터의 dyld 공유 캐시에서 SpringBoardFoundation 기본값 바인딩 테이블을 iOS 27.0과 비교해 설정 키를 추출하고 기존 분석에서 누락된 키를 보완했습니다. 각 키는 펌웨어 내부에서 존재가 확인됐지만, 실제 iPhone에서는 아직 테스트하지 않았습니다."
+        ]
+        return known[id] ?? fallback
+    }
+
+    static func tweakLabel(_ value: String) -> String {
+        let known: [String: String] = [
+            "Show Home Screen Search Button": "홈 화면 검색 버튼 표시",
+            "Debug HUD": "디버그 HUD 표시",
+            "Visualize Touch Suppression": "터치 차단 상태 시각화",

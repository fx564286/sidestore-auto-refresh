+    /// Present common runtime diagnostics in Korean without corrupting the
+    /// original log file, which retains exact technical strings for debugging.
+    private static func koreanLogLine(_ line: String) -> String {
+        if line.hasPrefix("Tweaks: ") {
+            return line.replacingOccurrences(of: "Tweaks: ", with: "기능 변경: ")
+                .replacingOccurrences(of: " file(s) from ", with: "개 파일 / ")
+                .replacingOccurrences(of: " plist(s)", with: "개 설정 파일")
+        }
+        if line.hasPrefix("PosterBoard: ") {
+            return "배경화면: " + String(line.dropFirst("PosterBoard: ".count))
+        }
+        if line.hasPrefix("UNSAFE OVERRIDE ACTIVE:") {
+            return "주의: 실험적 백업 생략 모드 실행 중 (복원 검증 전)"
+        }
+        if line.hasPrefix("Apply succeeded:") {
+            return "적용 성공 응답: " + String(line.dropFirst("Apply succeeded:".count))
+        }
+        if line.hasPrefix("Backup bypass: ") {
+            return "백업 생략: " + String(line.dropFirst("Backup bypass: ".count))
+        }
+        return line
+    }
+

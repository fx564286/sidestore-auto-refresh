     /// One row's line, in the reference's own vocabulary
     /// (`settings.py:823`): `when • mode • device • iOS version • result`.
+    /// Keep raw technical evidence in operations.json; translate only the UI.
+    private static func koreanHistoryError(_ raw: String) -> String {
+        let lower = raw.lowercased()
+        if lower.contains("mberrordomain/105") || lower.contains("insufficient free disk space") {
+            return "MBErrorDomain/105: 기기 저장 공간이 부족해 백업이 거부됐습니다. 디스크 공간 확인 후 다시 시도하세요."
+        }
+        if lower.contains("minimuxer is not ready") {
+            return "기기 연결이 준비되지 않았습니다. Wi-Fi·VPN 터널과 페어링 파일을 확인하세요."
+        }
+        if raw.contains("PosterBoard wallpaper edits require a native device snapshot") {
+            return "배경화면 변경에는 기기 데이터베이스가 필요합니다. 현재 적용 경로를 변경하세요."
+        }
+        return raw
+    }

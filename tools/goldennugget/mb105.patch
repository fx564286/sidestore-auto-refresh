+/// Query the volume that will actually receive the backup. LiveContainer may
+/// redirect guest Documents independently of NSHomeDirectory().
+/// Never report an invented free-space value if the query fails.
+private enum BackupVolumeSpace {
+    static func available(at rawPath: String) -> (bytes: UInt64, source: String)? {
+        guard !rawPath.isEmpty, rawPath.hasPrefix("/") else { return nil }
+        let fm = FileManager.default
+        var url = URL(fileURLWithPath: rawPath, isDirectory: true).standardizedFileURL
+        // The backup service can ask about a child before that child is created.
+        while !fm.fileExists(atPath: url.path) {
+            let parent = url.deletingLastPathComponent()
+            guard parent.path != url.path else { return nil }
+            url = parent
+        }
+
+        if let capacity = (try? url.resourceValues(
+            forKeys: [.volumeAvailableCapacityForImportantUsageKey]
+        ))?.volumeAvailableCapacityForImportantUsage, capacity >= 0 {
+            return (UInt64(capacity), "important-usage")
+        }
+
+        // URL resource values may be unavailable for a redirected container.
+        // FileManager resolves the free space on the same existing filesystem.
+        guard let attrs = try? fm.attributesOfFileSystem(forPath: url.path),
+              let free = attrs[.systemFreeSize] as? NSNumber else {
+            return nil
+        }
+        return (free.uint64Value, "filemanager")
+    }
+}

diff --git a/Nugget/Core/RoxyLivePhotoInstaller.swift b/Nugget/Core/RoxyLivePhotoInstaller.swift
new file mode 100644
index 0000000..8b6dcac
--- /dev/null
+++ b/Nugget/Core/RoxyLivePhotoInstaller.swift
@@ -0,0 +1,342 @@
+import AVFoundation
+import CoreGraphics
+import CoreMedia
+import CoreVideo
+import Foundation
+import ImageIO
+import Photos
+import UniformTypeIdentifiers
+
+/// Native iOS fallback when PosterBoard private database writes are denied.
+///
+/// It converts the ORIGINAL community publisher's animated Roxy preview
+/// into a genuine, metadata-paired Live Photo and asks PhotoKit to save the
+/// resulting asset. It never modifies PosterBoard or LiveContainer host files.
+///
+/// A Photos Live Photo is not a PosterBoard LayeredAnimation installation.
+/// iOS may independently refuse its motion as a Lock Screen wallpaper.
+enum RoxyLivePhotoInstaller {
+    private static let preview = URL(
+        string: "https://raw.githubusercontent.com/CAPlayground/wallpapers/refs/heads/main/previews/gif/Roxy_Migurdia_.gif")!
+
+    private static let fps: Int32 = 15
+    private static let frameCount = 45 // Three-second Live Photo duration.
+    private static let videoWidth = 720
+    private static let maxDownload = 12 * 1024 * 1024
+
+    struct Pair {
+        let photo: URL
+        let video: URL
+    }
+
+    private static func failure(_ message: String) -> NSError {
+        NSError(domain: "GoldenNugget.LivePhoto", code: 1,
+                userInfo: [NSLocalizedDescriptionKey: message])
+    }
+
+    @MainActor
+    static func saveRoxyToPhotos(status: @escaping (String) -> Void) async throws {
+        status("사진 보관함 권한 확인 중…")
+        let authorization = await PHPhotoLibrary.requestAuthorization(for: .addOnly)
+        guard authorization == .authorized || authorization == .limited else {
+            throw failure("사진 보관함에 추가할 권한이 없습니다. iOS 설정 → 개인정보 보호 및 보안 → 사진에서 Scarlet Crystal 권한을 확인하세요.")
+        }
+
+        status("제작자 원본 애니메이션을 내려받는 중…")
+        var request = URLRequest(url: preview)
+        request.timeoutInterval = 45
+        let (gif, response) = try await URLSession.shared.data(for: request)
+        guard let http = response as? HTTPURLResponse, http.statusCode == 200,
+              gif.count > 100_000, gif.count <= maxDownload,
+              gif.prefix(3).elementsEqual(Data("GIF".utf8)) else {
+            throw failure("원본 애니메이션 GIF 다운로드 또는 파일 검증에 실패했습니다.")
+        }
+
+        status("움직이는 Live Photo 사진·영상 생성 중…")
+        let work = FileManager.default.temporaryDirectory
+            .appendingPathComponent("gn-roxy-live-photo-\(UUID().uuidString)", isDirectory: true)
+        try FileManager.default.createDirectory(at: work, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: work) }
+
+        let pair = try await Task.detached(priority: .userInitiated) {
+            try await makePair(from: gif, in: work)
+        }.value
+
+        status("사진 앱에 Live Photo 한 장으로 저장 중…")
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+            PHPhotoLibrary.shared().performChanges({
+                let request = PHAssetCreationRequest.forAsset()
+                let photoOptions = PHAssetResourceCreationOptions()
+                photoOptions.shouldMoveFile = false
+                let videoOptions = PHAssetResourceCreationOptions()
+                videoOptions.shouldMoveFile = false
+                request.addResource(with: .photo, fileURL: pair.photo, options: photoOptions)
+                request.addResource(with: .pairedVideo, fileURL: pair.video, options: videoOptions)
+            }, completionHandler: { success, error in
+                if success { continuation.resume(returning: ()) }
+                else {
+                    continuation.resume(throwing: error ??
+                        failure("사진 앱에서 Live Photo 저장을 거부했습니다."))
+                }
+            })
+        }
+
+        status("저장 완료: 사진 앱에서 Live Photo를 연 뒤 iPhone 잠금화면 배경화면으로 선택하세요. 움직임 허용 여부는 iOS가 별도로 판단합니다.")
+    }
+
+    private static func makePair(from gif: Data, in directory: URL) async throws -> Pair {
+        guard let source = CGImageSourceCreateWithData(gif as CFData, nil) else {
+            throw failure("원본 애니메이션을 해석하지 못했습니다.")
+        }
+        let count = CGImageSourceGetCount(source)
+        guard count >= 2 && count <= 240 else {
+            throw failure("원본 애니메이션 프레임 수가 비정상적입니다.")
+        }
+        guard let first = CGImageSourceCreateImageAtIndex(source, 0, nil) else {
+            throw failure("첫 애니메이션 프레임을 읽지 못했습니다.")
+        }
+
+        // Preserve original aspect ratio. H.264 requires even dimensions.
+        let videoHeight = Int(
+            ceil(CGFloat(videoWidth) * CGFloat(first.height) / CGFloat(first.width) / 2)) * 2
+        guard videoHeight >= 300, videoHeight <= 2500 else {
+            throw failure("지원하지 않는 원본 이미지 비율입니다.")
+        }
+
+        var starts: [Double] = []
+        var cumulative = 0.0
+        for index in 0..<count {
+            starts.append(cumulative)
+            let props = CGImageSourceCopyPropertiesAtIndex(source, index, nil) as? [CFString: Any]
+            let gifProps = props?[kCGImagePropertyGIFDictionary] as? [CFString: Any]
+            let delay = gifProps?[kCGImagePropertyGIFUnclampedDelayTime] as? Double ??
+                gifProps?[kCGImagePropertyGIFDelayTime] as? Double ?? 0.067
+            cumulative += min(0.2, max(0.02, delay))
+        }
+        guard cumulative > 0.2 && cumulative < 60 else {
+            throw failure("애니메이션 재생 시간이 올바르지 않습니다.")
+        }
+
+        let identifier = UUID().uuidString
+        let jpeg = directory.appendingPathComponent("Roxy-Migurdia-Live.jpg")
+        let mov = directory.appendingPathComponent("Roxy-Migurdia-Live.mov")
+        let markerSecond = Double(frameCount / 2) / Double(fps)
+        let middleFrame = frameIndex(at: markerSecond * cumulative / 3.0, starts: starts)
+        guard let still = CGImageSourceCreateImageAtIndex(source, middleFrame, nil) else {
+            throw failure("Live Photo 대표 사진을 추출하지 못했습니다.")
+        }
+        try writeJPEG(still, width: videoWidth, height: videoHeight,
+                      assetIdentifier: identifier, to: jpeg)
+        try await writeMOV(source: source, starts: starts, duration: cumulative,
+                           width: videoWidth, height: videoHeight,
+                           assetIdentifier: identifier, to: mov)
+
+        let photoSize = (try? jpeg.resourceValues(forKeys: [.fileSizeKey]).fileSize) ?? 0
+        let videoSize = (try? mov.resourceValues(forKeys: [.fileSizeKey]).fileSize) ?? 0
+        guard photoSize > 20_000, videoSize > 100_000 else {
+            throw failure("Live Photo 파일 생성 결과를 검증하지 못했습니다.")
+        }
+        return Pair(photo: jpeg, video: mov)
+    }
+
+    private static func frameIndex(at time: Double, starts: [Double]) -> Int {
+        let index = starts.lastIndex(where: { $0 <= time }) ?? 0
+        return max(0, min(starts.count - 1, index))
+    }
+
+    private static func render(_ image: CGImage, in context: CGContext,
+                               width: Int, height: Int) {
+        context.saveGState()
+        defer { context.restoreGState() }
+        context.clear(CGRect(x: 0, y: 0, width: width, height: height))
+        // Preserve image aspect ratio, avoiding letterboxing on iPhone.
+        let scale = max(CGFloat(width) / CGFloat(image.width),
+                        CGFloat(height) / CGFloat(image.height))
+        let targetW = CGFloat(image.width) * scale
+        let targetH = CGFloat(image.height) * scale
+        let target = CGRect(x: (CGFloat(width) - targetW) / 2,
+                            y: (CGFloat(height) - targetH) / 2,
+                            width: targetW, height: targetH)
+        context.draw(image, in: target)
+    }
+
+    private static func writeJPEG(_ image: CGImage, width: Int, height: Int,
+                                  assetIdentifier: String, to output: URL) throws {
+        let pixels = UnsafeMutableRawPointer.allocate(byteCount: width * height * 4, alignment: 16)
+        defer { pixels.deallocate() }
+        pixels.initializeMemory(as: UInt8.self, repeating: 0, count: width * height * 4)
+        let colorSpace = CGColorSpaceCreateDeviceRGB()
+        guard let ctx = CGContext(data: pixels,
+                                  width: width, height: height, bitsPerComponent: 8,
+                                  bytesPerRow: width * 4, space: colorSpace,
+                                  bitmapInfo: CGImageAlphaInfo.premultipliedFirst.rawValue),
+              let dest = CGImageDestinationCreateWithURL(
+                  output as CFURL, UTType.jpeg.identifier as CFString, 1, nil) else {
+            throw failure("Live Photo 대표 사진의 렌더러를 만들지 못했습니다.")
+        }
+        render(image, in: ctx, width: width, height: height)
+        guard let still = ctx.makeImage() else {
+            throw failure("Live Photo 대표 사진 생성 실패")
+        }
+        let properties: [CFString: Any] = [
+            kCGImagePropertyMakerAppleDictionary: ["17": assetIdentifier],
+            kCGImagePropertyOrientation: 1
+        ]
+        CGImageDestinationAddImage(dest, still, properties as CFDictionary)
+        guard CGImageDestinationFinalize(dest) else {
+            throw failure("Live Photo JPEG 메타데이터 기록 실패")
+        }
+    }
+
+    private static func writeMOV(source: CGImageSource, starts: [Double],
+                                 duration: Double, width: Int, height: Int,
+                                 assetIdentifier: String, to output: URL) async throws {
+        let writer = try AVAssetWriter(outputURL: output, fileType: .mov)
+
+        let identifier = AVMutableMetadataItem()
+        identifier.keySpace = AVMetadataKeySpace(rawValue: "mdta")
+        identifier.key = "com.apple.quicktime.content.identifier" as NSString
+        identifier.value = assetIdentifier as NSString
+        identifier.dataType = "com.apple.metadata.datatype.UTF-8"
+        writer.metadata = [identifier]
+
+        let settings: [String: Any] = [
+            AVVideoCodecKey: AVVideoCodecType.h264,
+            AVVideoWidthKey: width,
+            AVVideoHeightKey: height,
+            AVVideoCompressionPropertiesKey: [
+                AVVideoAverageBitRateKey: 4_500_000,
+                AVVideoExpectedSourceFrameRateKey: fps,
+                AVVideoMaxKeyFrameIntervalKey: 15
+            ]
+        ]
+        let video = AVAssetWriterInput(mediaType: .video, outputSettings: settings)
+        video.expectsMediaDataInRealTime = false
+        let attributes: [String: Any] = [
+            kCVPixelBufferPixelFormatTypeKey as String: Int(kCVPixelFormatType_32BGRA),
+            kCVPixelBufferWidthKey as String: width,
+            kCVPixelBufferHeightKey as String: height,
+            kCVPixelBufferIOSurfacePropertiesKey as String: [:] as [String: Any]
+        ]
+        let adaptor = AVAssetWriterInputPixelBufferAdaptor(
+            assetWriterInput: video, sourcePixelBufferAttributes: attributes)
+        guard writer.canAdd(video) else { throw failure("동영상 트랙을 추가할 수 없습니다.") }
+        writer.add(video)
+
+        let formatSpec: [CFString: Any] = [
+            kCMMetadataFormatDescriptionMetadataSpecificationKey_Identifier:
+                "mdta/com.apple.quicktime.still-image-time",
+            kCMMetadataFormatDescriptionMetadataSpecificationKey_DataType:
+                "com.apple.metadata.datatype.int8"
+        ]
+        var metadataFormat: CMFormatDescription?
+        let result = CMMetadataFormatDescriptionCreateWithMetadataSpecifications(
+            allocator: kCFAllocatorDefault,
+            metadataType: kCMMetadataFormatType_Boxed,
+            metadataSpecifications: [formatSpec] as CFArray,
+            formatDescriptionOut: &metadataFormat)
+        guard result == noErr, let metadataFormat else {
+            throw failure("Live Photo 시간 메타데이터 생성 실패")
+        }
+        let metadataInput = AVAssetWriterInput(
+            mediaType: .metadata, outputSettings: nil,
+            sourceFormatHint: metadataFormat)
+        let metadataAdaptor = AVAssetWriterInputMetadataAdaptor(
+            assetWriterInput: metadataInput)
+        guard writer.canAdd(metadataInput) else {
+            throw failure("Live Photo 메타데이터 트랙 추가 실패")
+        }
+        writer.add(metadataInput)
+
+        guard writer.startWriting() else {
+            throw writer.error ?? failure("Live Photo MOV 인코딩 시작 실패")
+        }
+        writer.startSession(atSourceTime: .zero)
+
+        let marker = AVMutableMetadataItem()
+        marker.keySpace = AVMetadataKeySpace(rawValue: "mdta")
+        marker.key = "com.apple.quicktime.still-image-time" as NSString
+        marker.value = NSNumber(value: -1)
+        marker.dataType = "com.apple.metadata.datatype.int8"
+        let markerTime = CMTime(value: Int64(frameCount / 2), timescale: fps)
+        let markerGroup = AVTimedMetadataGroup(
+            items: [marker],
+            timeRange: CMTimeRange(start: markerTime,
+                                   duration: CMTime(value: 1, timescale: fps)))
+        guard metadataAdaptor.append(markerGroup) else {
+            writer.cancelWriting()
+            throw writer.error ?? failure("대표 프레임 시간 기록 실패")
+        }
+        metadataInput.markAsFinished()
+
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+            let queue = DispatchQueue(label: "com.goldennugget.roxy-live-photo.writer",
+                                      qos: .userInitiated)
+            var index = 0
+            var completed = false
+            video.requestMediaDataWhenReady(on: queue) {
+                if completed { return }
+                while video.isReadyForMoreMediaData {
+                    guard index < frameCount else {
+                        completed = true
+                        video.markAsFinished()
+                        writer.finishWriting {
+                            if writer.status == .completed {
+                                continuation.resume(returning: ())
+                            } else {
+                                continuation.resume(throwing: writer.error ??
+                                    failure("Live Photo MOV 인코딩이 완료되지 않았습니다."))
+                            }
+                        }
+                        return
+                    }
+                    guard let pool = adaptor.pixelBufferPool else {
+                        completed = true
+                        writer.cancelWriting()
+                        continuation.resume(throwing: failure("비디오 픽셀버퍼 풀을 확보하지 못했습니다."))
+                        return
+                    }
+                    var buffer: CVPixelBuffer?
+                    let rc = CVPixelBufferPoolCreatePixelBuffer(kCFAllocatorDefault, pool, &buffer)
+                    guard rc == kCVReturnSuccess, let buffer else {
+                        completed = true
+                        writer.cancelWriting()
+                        continuation.resume(throwing: failure("비디오 프레임 메모리 할당 실패"))
+                        return
+                    }
+                    let originalTime = Double(index) / Double(fps) * duration / 3.0
+                    let originalIndex = frameIndex(at: originalTime, starts: starts)
+                    guard let frame = CGImageSourceCreateImageAtIndex(
+                        source, originalIndex, nil) else {
+                        completed = true
+                        writer.cancelWriting()
+                        continuation.resume(throwing: failure("원본 애니메이션 프레임 해석 실패"))
+                        return
+                    }
+                    CVPixelBufferLockBaseAddress(buffer, [])
+                    let context = CGContext(
+                        data: CVPixelBufferGetBaseAddress(buffer),
+                        width: width, height: height, bitsPerComponent: 8,
+                        bytesPerRow: CVPixelBufferGetBytesPerRow(buffer),
+                        space: CGColorSpaceCreateDeviceRGB(),
+                        bitmapInfo: CGBitmapInfo.byteOrder32Little.rawValue
+                            | CGImageAlphaInfo.premultipliedFirst.rawValue)
+                    if let context {
+                        render(frame, in: context, width: width, height: height)
+                    }
+                    CVPixelBufferUnlockBaseAddress(buffer, [])
+                    guard context != nil,
+                          adaptor.append(buffer, withPresentationTime:
+                            CMTime(value: Int64(index), timescale: fps)) else {
+                        completed = true
+                        writer.cancelWriting()
+                        continuation.resume(throwing: writer.error ??
+                            failure("애니메이션 프레임 인코딩 실패"))
+                        return
+                    }
+                    index += 1
+                }
+            }
+        }
+    }
+}

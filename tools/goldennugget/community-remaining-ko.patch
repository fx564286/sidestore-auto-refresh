 /// Display-only Korean copy for the current verified community catalog.
 /// The server's metadata, hashes, package bytes and file paths remain intact.
 private enum CommunityCopyKorean {
+    struct ChangedFile: Identifiable {
+        let path: String
+        var labels: [String]
+        var id: String { path }
+    }
+
+    /// Catalog wires stay in English to preserve compatibility. Rendering can
+    /// translate labels while keeping every original absolute path untouched.
+    static func changedFiles(_ raw: [String]) -> [ChangedFile] {
+        var groups: [ChangedFile] = []
+        for item in raw {
+            guard let delimiter = item.range(of: ": ") else {
+                groups.append(ChangedFile(path: item, labels: []))
+                continue
+            }
+            let originalLabel = String(item[..<delimiter.lowerBound])
+            let path = String(item[delimiter.upperBound...])
+            let label = tweakLabel(originalLabel)
+            if let index = groups.firstIndex(where: { $0.path == path }) {
+                if !groups[index].labels.contains(label) {
+                    groups[index].labels.append(label)
+                }
+            } else {
+                groups.append(ChangedFile(path: path, labels: [label]))
+            }
+        }
+        return groups
+    }
+

+static inline BOOL WQAbsolutePathGrammar(NSString *path)
+{
+    if (![path hasPrefix:@"/"] || path.length < 2 || [path rangeOfString:@"\0"].location != NSNotFound) return NO;
+    NSArray *parts = [path componentsSeparatedByString:@"/"];
+    for (NSUInteger i = 1; i < parts.count; i++) {
+        NSString *part = parts[i];
+        if (!part.length || [part isEqualToString:@"."] || [part isEqualToString:@".."]) return NO;
+    }
+    return YES;
+}
+
+static inline int WQCreateDirectoriesNoLinksMode(NSString *path, mode_t mode)
+{
+    path = WQCanonicalVarPath(path);
+    if (!WQAbsolutePathGrammar(path)) { errno = EINVAL; return -1; }
+    int fd = open("/", O_SEARCH | O_CLOEXEC);
+    if (fd < 0) return -1;
+    for (NSString *part in [path componentsSeparatedByString:@"/"]) {
+        if (!part.length) continue;
+        int next = openat(fd, part.fileSystemRepresentation, O_SEARCH | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+        if (next < 0 && errno == ENOENT) {
+            if (mkdirat(fd, part.fileSystemRepresentation, mode) != 0 && errno != EEXIST) { int err = errno; close(fd); errno = err; return -1; }
+            if (!WQSyncDirectory(fd)) { int err = errno; close(fd); errno = err; return -1; }
+            next = openat(fd, part.fileSystemRepresentation, O_SEARCH | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+        }
+        int err = errno;
+        close(fd);
+        if (next < 0) { errno = err; return -1; }
+        fd = next;
+    }
+    int result = openat(fd, ".", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+    int err = errno;
+    close(fd);
+    if (result < 0) errno = err;
+    return result;
+}
+
+static inline int WQCreateDirectoriesNoLinks(NSString *path)
+{
+    return WQCreateDirectoriesNoLinksMode(path, 0700);
+}
+
+static inline BOOL WQBackupStampValid(NSString *stamp)
+{
+    if (stamp.length < 15) return NO;
+    static NSCache<NSString *, NSNumber *> *cache;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        cache = [NSCache new];
+        cache.countLimit = 1024;
+    });
+    NSNumber *known = [cache objectForKey:stamp];
+    if (known) return known.boolValue;
+
+    // Recognize the historical second/millisecond stamps and the current
+    // millisecond-counter format. No arbitrary directory can become a restore.
+    NSString *pattern = @"^[0-9]{8}-[0-9]{6}(-[0-9]{3}(-[1-9][0-9]*)?)?$";
+    NSRange match = [stamp rangeOfString:pattern options:NSRegularExpressionSearch];
+    if (match.location != 0 || match.length != stamp.length) return NO;
+    NSArray *parts = [stamp componentsSeparatedByString:@"-"];
+    if (parts.count == 4) {
+        uint64_t number = 0;
+        for (NSUInteger i = 0; i < [parts[3] length]; i++) {
+            unsigned digit = [parts[3] characterAtIndex:i] - '0';
+            if (number > (UINT64_MAX - digit) / 10) return NO;
+            number = number * 10 + digit;
+        }
+    }
+    NSDateFormatter *fmt = [NSDateFormatter new];
+    fmt.locale = [NSLocale localeWithLocaleIdentifier:@"en_US_POSIX"];
+    fmt.calendar = [[NSCalendar alloc] initWithCalendarIdentifier:NSCalendarIdentifierGregorian];
+    fmt.timeZone = [NSTimeZone timeZoneForSecondsFromGMT:0];
+    fmt.lenient = NO;
+    fmt.dateFormat = @"yyyyMMdd-HHmmss";
+    NSString *datePart = [stamp substringToIndex:15];
+    NSDate *date = [fmt dateFromString:datePart];
+    BOOL valid = date && [[fmt stringFromDate:date] isEqualToString:datePart];
+    [cache setObject:@(valid) forKey:stamp];
+    return valid;
+}
+
+// One numeric field of a valid stamp (digits only, overflow already ruled out
+// by WQBackupStampValid).
+static inline uint64_t WQBackupStampField(NSString *part)
+{
+    uint64_t number = 0;
+    for (NSUInteger i = 0; i < part.length; i++) number = number * 10 + (uint64_t)([part characterAtIndex:i] - '0');
+    return number;
+}
+
+// Chronological order of backup unit names: date-time, then milliseconds,
+// then the counter as a number ("-10" is newer than "-9"). A legacy stamp
+// without milliseconds or counter sorts before one with them at the same
+// prefix. Invalid names fall back to text order, after every valid stamp.
+// The time is local wall-clock time: a later clock or time-zone rollback can
+// still make a newer unit compare older (the format stores no offset).
+static inline NSComparisonResult WQBackupStampCompare(NSString *a, NSString *b)
+{
+    BOOL validA = WQBackupStampValid(a), validB = WQBackupStampValid(b);
+    if (!validA || !validB) {
+        if (validA != validB) return validA ? NSOrderedAscending : NSOrderedDescending;
+        return [a compare:b];
+    }
+    NSArray<NSString *> *pa = [a componentsSeparatedByString:@"-"], *pb = [b componentsSeparatedByString:@"-"];
+    for (NSUInteger i = 0; i < MAX(pa.count, pb.count); i++) {
+        if (i >= pa.count) return NSOrderedAscending;
+        if (i >= pb.count) return NSOrderedDescending;
+        uint64_t x = WQBackupStampField(pa[i]), y = WQBackupStampField(pb[i]);
+        if (x != y) return x < y ? NSOrderedAscending : NSOrderedDescending;
+    }
+    return NSOrderedSame;
+}
+#endif
diff --git a/Erosion/Exploits/PosterBoardLSStoreCore.h b/Erosion/Exploits/PosterBoardLSStoreCore.h
new file mode 100644
index 0000000..f31149e
--- /dev/null
+++ b/Erosion/Exploits/PosterBoardLSStoreCore.h
@@ -0,0 +1,161 @@
+/*
+ * Narrow, bounded CSStore2 parser for one exact bundle identity:
+ * com.apple.PosterBoard -> Data/Application/<UUID>.
+ * Derived from WQFiles WQLaunchServices.m (GPL-3.0-or-later), 0d9c28c.
+ * This parser is intentionally READ ONLY and never treats a plain UUID
+ * as sufficient proof of identity. For unknown/partial layouts it FAILS.
+ */
+#ifndef POSTERBOARD_LS_STORE_CORE_H
+#define POSTERBOARD_LS_STORE_CORE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <ctype.h>
+
+#define PBLS_MAX_BYTES (64u*1024u*1024u)
+#define PBLS_MAX_PATHS 20000u
+#define PBLS_MAX_IDS 32u
+#define PBLS_PATH_SIZE 160u
+
+typedef struct {
+    uint32_t ref;
+    char path[PBLS_PATH_SIZE];
+    bool conflicted;
+} PBLSPath;
+typedef struct {
+    bool verified;
+    char container[PBLS_PATH_SIZE];
+    size_t stringsFound, pathReferences, recordsMatched, matchedIDs, conflicting,
+        layoutScore, layoutsTried;
+    int selectedLayout;
+} PBLSResult;
+static inline uint32_t pbls_u32(const uint8_t *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1]<<8) |
+           ((uint32_t)p[2]<<16) | ((uint32_t)p[3]<<24);
+}
+static inline bool pbls_uuid36(const char *p) {
+    for (size_t i=0; i<36; ++i) {
+        char c=p[i];
+        if (i==8||i==13||i==18||i==23) {
+            if (c!='-') return false;
+        } else if (!isxdigit((unsigned char)c)) return false;
+    }
+    return true;
+}
+static inline bool pbls_container_path(const char *s,size_t len) {
+    const char *privatePrefix="/private/var/mobile/Containers/Data/Application/";
+    const char *mobilePrefix="/var/mobile/Containers/Data/Application/";
+    size_t n1=strlen(privatePrefix),n2=strlen(mobilePrefix);
+    const char *uuid=NULL;
+    if ((len==n1+36 || len==n1+37) && !memcmp(s,privatePrefix,n1)) {
+        if(len==n1+37&&s[len-1]!='/') return false;
+        uuid=s+n1;
+    } else if ((len==n2+36 || len==n2+37)&&!memcmp(s,mobilePrefix,n2)) {
+        if(len==n2+37&&s[len-1]!='/') return false;
+        uuid=s+n2;
+    }
+    return uuid&&pbls_uuid36(uuid);
+}
+static inline PBLSPath *pbls_path_by_ref(PBLSPath *items,size_t n,uint32_t ref) {
+    for(size_t i=0;i<n;++i)if(items[i].ref==ref)return items+i;
+    return NULL;
+}
+static inline bool pbls_has_ref(const uint32_t *items,size_t n,uint32_t value) {
+    for(size_t i=0;i<n;++i)if(items[i]==value)return true;
+    return false;
+}
+static inline PBLSResult pbls_parse(const void *data,size_t size) {
+    PBLSResult r={0};
+    if(!data||size<0x1000||size>PBLS_MAX_BYTES) return r;
+    const uint8_t *b=(const uint8_t*)data;
+    if(memcmp(b,"bdsl",4))return r;
+    const char *target="com.apple.PosterBoard";
+    size_t targetlen=strlen(target);
+    uint32_t targetRefs[PBLS_MAX_IDS]={0};
+    size_t targetCount=0;
+    PBLSPath *paths=(PBLSPath*)calloc(PBLS_MAX_PATHS,sizeof(PBLSPath));
+    if(!paths)return r;
+    size_t pathCount=0;
+    // A string entry is [u32 id][u32 byte-length][bytes]. Record references
+    // to it are (id << 2). Layout selection follows WQFiles' known offsets.
+    for(size_t off=0;off+8<size;off+=4) {
+        uint32_t id=pbls_u32(b+off),len=pbls_u32(b+off+4);
+        if(id==0||id>=0x01000000u||len==0||len>=PBLS_PATH_SIZE ||
+           len>size-off-8)continue;
+        const uint8_t *str=b+off+8;
+        if(len==targetlen&&!memcmp(str,target,targetlen)) {
+            if(targetCount<PBLS_MAX_IDS&&!pbls_has_ref(targetRefs,targetCount,id<<2))
+                targetRefs[targetCount++]=id<<2;
+            continue;
+        }
+        if(!pbls_container_path((const char*)str,len))continue;
+        if(pathCount>=PBLS_MAX_PATHS)goto finish;
+        // CSStore string IDs can alias different strings on iOS 26; never
+        // trust a path reference that points to two different paths.
+        PBLSPath *existing=pbls_path_by_ref(paths,pathCount,id<<2);
+        if(existing) {
+            char normalized[PBLS_PATH_SIZE]={0};
+            memcpy(normalized,str,len);
+            if(len&&normalized[len-1]=='/')normalized[len-1]=0;
+            if(strcmp(existing->path,normalized)) existing->conflicted=true;
+            continue;
+        }
+        PBLSPath *item=&paths[pathCount++];
+        item->ref=id<<2;
+        memcpy(item->path,str,len);
+        if(item->path[len-1]=='/')item->path[len-1]=0;
+    }
+    r.stringsFound=targetCount;
+    r.pathReferences=pathCount;
+    if(!targetCount||!pathCount)goto finish;
+    struct PBLSLayout {uint32_t size,bundleOff,pathOff;};
+    const struct PBLSLayout layout[]={
+      {0x25c,0x0c,0x6c}, {0x25c,0x10,0x6c},
+      {0x250,0x0c,0x68}, {0x23c,0x0c,0x64}
+    };
+    size_t bestScore=0,bestMatches=0,bestConflict=0;
+    char bestPath[PBLS_PATH_SIZE]={0};
+    int best=-1;
+    for(size_t li=0;li<sizeof(layout)/sizeof(layout[0]);++li) {
+        const struct PBLSLayout L=layout[li];
+        size_t score=0,match=0,conflict=0;
+        char candidate[PBLS_PATH_SIZE]={0};
+        for(size_t off=0;off+8+L.size<=size;off+=4) {
+            if(pbls_u32(b+off+4)!=L.size)continue;
+            const uint8_t *row=b+off+8;
+            uint32_t idref=pbls_u32(row+L.bundleOff);
+            uint32_t pathref=pbls_u32(row+L.pathOff);
+            if(!idref||!pathref)continue;
+            PBLSPath *path=pbls_path_by_ref(paths,pathCount,pathref);
+            if(!path||path->conflicted)continue;
+            score++;
+            if(!pbls_has_ref(targetRefs,targetCount,idref))continue;
+            match++;
+            if(!candidate[0])strncpy(candidate,path->path,sizeof(candidate)-1);
+            else if(strcmp(candidate,path->path))conflict++;
+        }
+        r.layoutsTried++;
+        if(score>bestScore) {
+            bestScore=score;bestMatches=match;bestConflict=conflict;
+            best=(int)li;memcpy(bestPath,candidate,sizeof(bestPath));
+        }
+    }
+    r.layoutScore=bestScore;r.selectedLayout=best;
+    r.recordsMatched=bestMatches;r.conflicting=bestConflict;
+    r.matchedIDs=bestMatches;
+    // The source contains many app containers. A spurious record layout may
+    // accidentally match a single target: accept only coverage >= 50% of
+    // path references when there are at least 20, and >= 8 layout matches.
+    if(bestScore<8 || bestMatches<1 || bestConflict ||
+       (pathCount>=20 && bestScore*2<pathCount))goto finish;
+    if(!pbls_container_path(bestPath,strlen(bestPath)))goto finish;
+    memcpy(r.container,bestPath,sizeof(r.container));
+    r.verified=true;
+finish:
+    free(paths);
+    return r;
+}
+#endif

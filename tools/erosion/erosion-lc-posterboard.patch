+// Read-only fast path for GoldenNugget/Erosion PosterBoard wallpapers.
+// Matching a directory named PRBPosterExtensionDataStore alone is not enough:
+// require it under the standard Application/UUID/Library/Application Support
+// layout and validate the UUID shape. This avoids arbitrary path guesses.
+static NSString *posterboardContainerInPath(NSString *path) {
+    NSString *normalized = [path hasPrefix:@"/private/var/"]
+        ? [path substringFromIndex:8] : path;
+    NSString *prefix = @"/var/mobile/Containers/Data/Application/";
+    NSString *suffix = @"/Library/Application Support/PRBPosterExtensionDataStore";
+    if (![normalized hasPrefix:prefix]) return nil;
+    NSUInteger from = prefix.length;
+    if (normalized.length < from + 36 + suffix.length) return nil;
+    NSString *uuidString = [normalized substringWithRange:NSMakeRange(from, 36)];
+    if (![[NSUUID alloc] initWithUUIDString:uuidString]) return nil;
+    if (![[normalized substringFromIndex:from + 36] hasPrefix:suffix]) return nil;
+    NSUInteger next = from + 36 + suffix.length;
+    if (next < normalized.length && [normalized characterAtIndex:next] != '/') return nil;
+    return [normalized substringToIndex:from + 36];
+}
+
+NSString *pathleak_posterboard(uint64_t max_inode) {
+    if (max_inode < 1 || max_inode > 15000000) return nil;
+    struct statfs sfs;
+    if (statfs("/var/mobile/Containers/Data/Application", &sfs) != 0 &&
+        statfs("/private/var", &sfs) != 0) return nil;
+    fsid_t fsid = sfs.f_fsid;
+    char buffer[PATH_MAX];
+    for (uint64_t inode = 1; inode <= max_inode; inode++) {
+        if (fsgetpath(buffer, sizeof(buffer), &fsid, inode) <= 0) continue;
+        NSString *path = [NSString stringWithUTF8String:buffer];
+        if (!path) continue;
+        NSString *container = posterboardContainerInPath(path);
+        if (container) {
+            NSLog(@"(fs) read-only PosterBoard marker found (inode=%llu)", inode);
+            return container;
+        }
+    }
+    return nil;
+}

+NSString *posterboard_container_manager_path(void) {
+    typedef void *(*cq_create_fn)(void);
+    typedef void (*cq_set_class_fn)(void *, uint64_t);
+    typedef void (*cq_iterate_fn)(void *, bool (^)(void *));
+    typedef void (*cq_free_fn)(void *);
+    typedef const char *(*co_get_string_fn)(void *);
+    void *mgr = dlopen("/usr/lib/system/libsystem_containermanager.dylib",
+                       RTLD_NOW | RTLD_LOCAL);
+    if (!mgr) {
+        setPosterboardManagerLookupSummary(@"시스템 컨테이너 관리자 라이브러리 로드 실패");
+        NSLog(@"(pb) container manager library unavailable");
+        return nil;
+    }
+    cq_create_fn create = (cq_create_fn)dlsym(mgr, "container_query_create");
+    cq_set_class_fn setClass = (cq_set_class_fn)dlsym(mgr, "container_query_set_class");
+    cq_iterate_fn iterate = (cq_iterate_fn)dlsym(mgr, "container_query_iterate_results_sync");
+    cq_free_fn queryFree = (cq_free_fn)dlsym(mgr, "container_query_free");
+    co_get_string_fn getPath = (co_get_string_fn)dlsym(mgr, "container_object_get_path");
+    co_get_string_fn getID = (co_get_string_fn)dlsym(mgr, "container_object_get_identifier");
+    if (!getID) getID = (co_get_string_fn)dlsym(mgr, "container_result_get_identifier");
+    if (!create || !setClass || !iterate || !queryFree || !getPath || !getID) {
+        setPosterboardManagerLookupSummary(
+            [NSString stringWithFormat:@"필수 API 누락: create=%d class=%d iterate=%d free=%d path=%d id=%d",
+             !!create, !!setClass, !!iterate, !!queryFree, !!getPath, !!getID]);
+        NSLog(@"(pb) container-manager query functions unavailable");
+        dlclose(mgr);
+        return nil;
+    }
+    const uint64_t classes[] = { 2, 0, 5, 7, 8, 10, 11, 13 };
+    NSString *const prefix = @"/var/mobile/Containers/Data/Application/";
+    __block NSString *found = nil;
+    __block NSUInteger inspected = 0;
+    __block NSUInteger identified = 0;
+    __block NSUInteger posterboardIDs = 0;
+    __block NSUInteger invalidPosterboardPaths = 0;
+    NSUInteger executedClasses = 0;
+    for (size_t i = 0; i < sizeof(classes)/sizeof(classes[0]); ++i) {
+        if (found) break;
+        void *query = create();
+        if (!query) continue;
+        executedClasses++;
+        setClass(query, classes[i]);
+        iterate(query, ^bool(void *object) {
+            if (!object) return true;
+            inspected++;
+            const char *idString = getID(object);
+            if (!idString || !idString[0]) return true;
+            identified++;
+            if (strcmp(idString, "com.apple.PosterBoard") != 0) return true;
+            posterboardIDs++;
+            const char *pathString = getPath(object);
+            if (!pathString || !pathString[0]) {
+                invalidPosterboardPaths++;
+                return true;
+            }
+            NSString *path = [NSString stringWithUTF8String:pathString];
+            if (!path.length) return true;
+            NSString *normalized = [path hasPrefix:@"/private/var/"]
+                ? [path substringFromIndex:8] : path;
+            // A bundle ID alone cannot authorize an arbitrary filesystem
+            // write. Accept only the canonical Apple data-container layout.
+            if (![normalized hasPrefix:prefix] ||
+                normalized.length != prefix.length + 36) {
+                invalidPosterboardPaths++;
+                return true;
+            }
+            NSString *uuidText = [normalized substringFromIndex:prefix.length];
+            if (![[NSUUID alloc] initWithUUIDString:uuidText]) {
+                invalidPosterboardPaths++;
+                return true;
+            }
+            found = normalized;
+            return false;
+        });
+        queryFree(query);
+    }
+    dlclose(mgr);
+    NSString *summary = [NSString stringWithFormat:
+        @"컨테이너 관리자 클래스 %lu/8, 검색 결과 %lu개, 식별자 %lu개, PosterBoard 일치 %lu개, 경로 거부 %lu개. %@",
+        (unsigned long)executedClasses, (unsigned long)inspected,
+        (unsigned long)identified, (unsigned long)posterboardIDs,
+        (unsigned long)invalidPosterboardPaths,
+        found ? @"실제 경로 확인" : @"일치하는 유효 경로 없음"];
+    setPosterboardManagerLookupSummary(summary);
+    NSLog(@"(pb) container manager summary: %@", summary);
+    return found;
+}
+
+// A separate identity source on iOS 27.2: lsd's CSStore2 has application
+// bundle IDs paired with data-container paths. WQFiles 0.9.6 uses this when
+// container-manager enumeration exposes only the few allowed host containers.
+// Select the latest lsd CSStore from recently allocated APFS object IDs,
+ // following WQFiles' bounded newest-first file-ID scan. A fixed 10m upper
+ // bound misses system files on devices with larger APFS inode numbers.
+static BOOL posterboardIsLSStorePath(NSString *raw) {
+    if (!raw.length) return NO;
+    NSString *p=[raw hasPrefix:@"/private/var/"] ? [raw substringFromIndex:8] : raw;
+    NSString *prefix=@"/var/mobile/Containers/Data/InternalDaemon/";
+    if (![p hasPrefix:prefix] || ![p hasSuffix:@".csstore"] ||
+        p.length < prefix.length + 36 + 42) return NO;
+    NSString *uuid=[p substringWithRange:NSMakeRange(prefix.length,36)];
+    if (![[NSUUID alloc] initWithUUIDString:uuid]) return NO;
+    NSString *rest=[p substringFromIndex:prefix.length+36];
+    if (![rest hasPrefix:@"/Library/Caches/com.apple.LaunchServices-"]) return NO;
+    NSString *filename=p.lastPathComponent;
+    return [filename hasPrefix:@"com.apple.LaunchServices-"] &&
+           [filename hasSuffix:@".csstore"];
+}
+
+NSString *posterboard_lsstore_file(uint64_t ignored_max_inode) {
+    (void)ignored_max_inode;  // no fixed upper bound: probe this volume first.
+    struct statfs volume={0};
+    if (statfs("/private/var", &volume)!=0) {
+        NSLog(@"(pb-ls) unable to inspect APFS volume");
+        return nil;
+    }
+    NSString *probe=[NSTemporaryDirectory() stringByAppendingPathComponent:
+                     [NSString stringWithFormat:@"erosion-ls-probe-%@",NSUUID.UUID.UUIDString]];
+    int fd=open(probe.fileSystemRepresentation,O_CREAT|O_EXCL|O_WRONLY,0600);
+    if (fd<0) { NSLog(@"(pb-ls) no writable temporary inode probe"); return nil; }
+    struct stat st={0};
+    struct statfs sourceVolume={0};
+    BOOL valid=(fstat(fd,&st)==0 && fstatfs(fd,&sourceVolume)==0);
+    close(fd);
+    unlink(probe.fileSystemRepresentation);
+    if (!valid || memcmp(&sourceVolume.f_fsid,&volume.f_fsid,sizeof(fsid_t)) ||
+        st.st_ino<=0 || (uint64_t)st.st_ino>INT64_MAX-100000) {
+        NSLog(@"(pb-ls) inode probe is not on the expected volume");
+        return nil;
+    }
+    // lsd rewrites CSStore on app install. Its object id is usually among the
+    // newest on the volume. Stop after a bounded interval instead of scanning
+    // old system files indefinitely.
+    int64_t maxInode=(int64_t)st.st_ino+100000;
+    const int64_t chunk=32768;
+    const int64_t chunks=(maxInode+chunk-1)/chunk;
+    CFAbsoluteTime started=CFAbsoluteTimeGetCurrent();
+    NSLock *lock=[NSLock new];
+    __block int64_t nextChunk=0;
+    __block NSString *found=nil;
+    NSUInteger workers=MAX((NSUInteger)1,MIN((NSUInteger)4,
+                             NSProcessInfo.processInfo.activeProcessorCount/2));
+    dispatch_apply(workers,dispatch_get_global_queue(QOS_CLASS_UTILITY,0),
+                   ^(size_t unused) {
+        (void)unused;
+        char buffer[PATH_MAX];
+        fsid_t fsid=volume.f_fsid;
+        while (true) {
+            [lock lock];
+            int64_t c=nextChunk++;
+            BOOL stop=found!=nil ||
+                      CFAbsoluteTimeGetCurrent()-started>20.0 || c>=chunks;
+            [lock unlock];
+            if (stop) return;
+            int64_t high=maxInode-c*chunk;
+            int64_t low=MAX((int64_t)1,high-chunk+1);
+            for(int64_t inode=high;inode>=low;--inode) {
+                if ((inode&127)==0 && CFAbsoluteTimeGetCurrent()-started>20.0)
+                    return;
+                if(fsgetpath(buffer,sizeof(buffer),&fsid,(uint64_t)inode)<=0)
+                    continue;
+                NSString *candidate=[NSString stringWithUTF8String:buffer];
+                if (!posterboardIsLSStorePath(candidate))continue;
+                [lock lock];
+                if(!found)found=candidate;
+                [lock unlock];
+                return;
+            }
+        }
+    });
+    NSLog(@"(pb-ls) recent-inode CSStore search: %@",found?@"found":@"not found");
+    return found;
+}
+
+NSDictionary<NSString *,id>* posterboard_lsstore_parse(NSData *data) {
+    PBLSResult result=pbls_parse(data.bytes,data.length);
+    NSString *path=result.verified?[NSString stringWithUTF8String:result.container]:@"";
+    return @{
+        @"verified":@(result.verified),
+        @"path":path?:@"",
+        @"stringIDs":@(result.stringsFound),
+        @"pathRefs":@(result.pathReferences),
+        @"layoutScore":@(result.layoutScore),
+        @"targetMatches":@(result.recordsMatched),
+        @"conflicts":@(result.conflicting),
+        @"layout":@(result.selectedLayout)
+    };
+}
